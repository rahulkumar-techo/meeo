{
  "expo": {
    "name": "meeo",
    "slug": "meeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "scheme": "meeo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icons/icon.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "tez",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay",
          "whatsapp",
          "amazonpay",
          "mobikwik",
          "freecharge"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#502307",
        "foregroundImage": "./assets/app-icons/adaptive-icon.png",
        "backgroundImage": "./assets/app-icons/adaptive-icon.png",
        "monochromeImage": "./assets/app-icons/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.mrrhl02.meeo",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/app-icons/favicon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icons/adaptive-icon.png",
          "color": "#208AEF"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "./withUpiQueries.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78af2ecb-99cf-4df3-b91e-e2181b92f9a7"
      }
    },
    "owner": "mrrhl02"
  }
}
